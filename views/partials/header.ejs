<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Produtos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="topbar">
        <div>
            <strong>Controle de Produtos</strong>
        </div>

        <% if (usuario) { %>
            <nav>
                <% if (usuario) { %>
                    <a href="/dashboard">Dashboard</a>

                    <% if (usuario.tipo !== "visualizador") { %>
                        <a href="/nova-retirada">Nova retirada</a>
                    <% } %>

                    <a href="/retiradas">Retiradas</a>

                    <% if (usuario && (usuario.tipo === "admin" || usuario.tipo === "fotografia")) { %>
                        <a href="/conferencia-fotos">Conferência</a>
                    <% } %>

                    <a href="/logout">Sair</a>
                <% } %>
            </nav>
        <% } %>
    </header>

    <main class="container">